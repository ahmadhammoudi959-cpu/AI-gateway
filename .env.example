# ── Required in production ──────────────────────────────────────────
# Encrypts the providers' API keys. Generate once:  openssl rand -base64 32
# Keep a backup — if it changes, the saved provider keys must be re-entered.
ENCRYPTION_KEY=
# Signs dashboard sessions:  openssl rand -base64 32
SESSION_SECRET=
# First admin account (used only when no admin exists yet).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-password

# ── Database ────────────────────────────────────────────────────────
# Postgres connection string. Leave empty to use the embedded database stored in ./data
DATABASE_URL=
# Set to true if your Postgres provider requires SSL and the URL has no sslmode
# DATABASE_SSL=true

# ── Optional ────────────────────────────────────────────────────────
# Public address shown in the integration snippets (Render sets RENDER_EXTERNAL_URL itself)
PUBLIC_URL=
DEFAULT_TIMEZONE=Africa/Cairo
PORT=3000
# Max request body (images in base64 need room)
BODY_LIMIT=25mb
# Max time to wait for a provider response (ms)
UPSTREAM_TIMEOUT_MS=600000
# Browsers allowed to call /v1 directly ("*" = any). Calling from servers is not affected.
CORS_ORIGINS=*

# ── docker-compose only ─────────────────────────────────────────────
POSTGRES_PASSWORD=
DOMAIN=ai.example.com
